# Copy to an ignored .env.local and supply your own values. Never commit credentials.
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
APP_ORIGINS=http://localhost:8080
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Mailbox owner
# Public support contact shown on privacy and support pages.
SUPPORT_EMAIL=dev@tugan.io
OPERATOR_NAME=Gan Tu
ALLOWED_EMAILS=owner@example.com,second-inbox@example.com
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
FIRESTORE_DATABASE=email-auto-labeller
GMAIL_TOPIC=projects/your-oauth-client-project/topics/email-auto-labeller
PUSH_SERVICE_ACCOUNT=gmail-push@your-google-cloud-project.iam.gserviceaccount.com
# Optional comma-separated push identities during an OAuth project transition.
ADDITIONAL_PUSH_SERVICE_ACCOUNTS=
SCHEDULER_SERVICE_ACCOUNT=email-jobs@your-google-cloud-project.iam.gserviceaccount.com
DECISIONS_MODEL=gpt-6-luna
PROCESSING_ENABLED=false
# Legacy migration only: fallback text for existing recruiting drafts. New rules store their own reply template.
DECLINE_REPLY_TEXT=

# OAuth client and API secrets. In production, use Secret Manager references.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: needed only for imported accounts whose clientType is legacy.
LEGACY_GOOGLE_CLIENT_ID=
LEGACY_GOOGLE_CLIENT_SECRET=
# Optional during an OAuth project transition; retains existing web mailbox grants until reconnect.
PREVIOUS_WEB_GOOGLE_CLIENT_ID=
PREVIOUS_WEB_GOOGLE_CLIENT_SECRET=
PREVIOUS_WEB_GMAIL_TOPIC=
LEGACY_GMAIL_TOPIC=
OPENAI_API_KEY=
# A base64-encoded random 32-byte key; retain it when migrating encrypted accounts.
TOKEN_ENCRYPTION_KEY=

# Optional operator scripts. Set every SOURCE_* value before migration.
SERVICE_NAME=email-auto-labeller
REGION=us-central1
SOURCE_PROJECT=your-source-project
SOURCE_DATABASE=your-source-database
SOURCE_SERVICE=your-source-service
SOURCE_REGION=us-central1
SOURCE_PUSH_SUBSCRIPTION=your-source-push-subscription
SOURCE_SCHEDULER_PREFIX=your-source-service-
# Authenticated API smoke needs exactly two existing connected inboxes.
VERIFY_EMAILS=owner@example.com,second-inbox@example.com
VERIFY_EMAIL=owner@example.com
VERIFY_BASE_URL=http://localhost:8080
VERIFY_EVIDENCE_PATH=.local/api-smoke.json
